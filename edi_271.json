          "template": "benefits"
        }]
      },
      "dependent": { "xpath": "info_source_level/info_receiver_loop[./HL[level_code='21']][position()=1]/info_receiver_name/subscriber_level_loop[./HL[level_code='23']][position()=1]/subscriber_name_loop",
        "template": "name_loop"
      },
      "dependent_benefits": {
        "array": [{"xpath": "info_source_level/info_receiver_loop[./HL[level_code='21']][position()=1]/info_receiver_name/subscriber_level_loop[./HL[level_code='23']][position()=1]/subscriber_name_loop/subscriber_eb_loop",
          "template": "benefits"
        }]
      }
