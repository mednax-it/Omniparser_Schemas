        "plan_number": {"xpath": "REF[qualifier='18'][position()=1]/id"},
        "plan_name": {"xpath": "REF[qualifier='18'][position()=1]/name"},
        "ins_policy_number": {"xpath": "REF[qualifier='IG'][position()=1]/id"},
