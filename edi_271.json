      },
      "dependent_trace_info": {
        "array": [{"xpath": "info_source_level/info_receiver_loop/info_receiver_name/subscriber_level_loop[./HL[level_code='23']]",
          "template": "trace_info"}]
      },
      "subscriber": { "xpath": "info_source_level/info_receiver_loop[./HL[level_code='21']][position()=1]/info_receiver_name/subscriber_level_loop[./HL[level_code='22']][position()=1]/subscriber_name_loop",
